---
/**
 * Three-state theme selector: Light / Dark / Auto.
 *
 * Rendered with no button pressed, because a static page cannot know the
 * visitor's stored choice at build time. The script below sets the correct
 * `aria-pressed` on load. The whole control is hidden until the inline theme
 * script adds `.js` to <html>.
 */
const OPTIONS = [
	{ value: 'light', label: 'Light' },
	{ value: 'dark', label: 'Dark' },
	{ value: 'system', label: 'Auto' },
] as const;
---

<div class="theme-toggle print-hidden" role="group" aria-label="Theme selection">
	{
		OPTIONS.map((option, index) => (
			<>
				{index > 0 && <span class="separator" aria-hidden="true">·</span>}
				<button type="button" data-theme-option={option.value} aria-pressed="false">
					{option.label}
				</button>
			</>
		))
	}
	<span class="sr-only" aria-live="polite" data-theme-status></span>
</div>

<script>
	import { THEME_STORAGE_KEY } from '../consts';

	type Theme = 'light' | 'dark' | 'system';

	const root = document.documentElement;
	const media = window.matchMedia('(prefers-color-scheme: dark)');
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-option]');
	const status = document.querySelector<HTMLElement>('[data-theme-status]');

	/** The user's stored choice, or "system" when they have not chosen. */
	function storedTheme(): Theme {
		try {
			const value = localStorage.getItem(THEME_STORAGE_KEY);
			return value === 'light' || value === 'dark' ? value : 'system';
		} catch {
			return 'system';
		}
	}

	function apply(theme: Theme) {
		// Only an explicit choice gets a class; "system" leaves both off so the
		// prefers-color-scheme rules in global.css apply.
		root.classList.remove('light', 'dark');
		if (theme !== 'system') root.classList.add(theme);
		root.style.colorScheme = theme === 'system' ? 'light dark' : theme;

		buttons.forEach((button) => {
			button.setAttribute('aria-pressed', String(button.dataset.themeOption === theme));
		});

		if (status) {
			status.textContent =
				theme === 'system' ? 'Theme set to system preference' : `Theme set to ${theme} mode`;
		}
	}

	buttons.forEach((button) => {
		button.addEventListener('click', () => {
			const theme = (button.dataset.themeOption ?? 'system') as Theme;
			try {
				if (theme === 'system') localStorage.removeItem(THEME_STORAGE_KEY);
				else localStorage.setItem(THEME_STORAGE_KEY, theme);
			} catch {
				// Storage unavailable: the choice still applies for this page view.
			}
			apply(theme);
		});
	});

	// Follow the OS when the user is on "auto".
	media.addEventListener('change', () => {
		if (storedTheme() === 'system') apply('system');
	});

	// Keep other open tabs in step.
	window.addEventListener('storage', (event) => {
		if (event.key === THEME_STORAGE_KEY) apply(storedTheme());
	});

	// Reflect the stored choice in the buttons on first load.
	apply(storedTheme());
</script>

<style>
	.theme-toggle {
		display: none;
		align-items: center;
		gap: 0.125rem;
		font-size: 0.875rem;
		color: var(--muted-foreground);
	}

	/* Revealed only once the inline theme script has run. */
	:global(html.js) .theme-toggle {
		display: flex;
	}

	.theme-toggle button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		/* 44px minimum target, per WCAG 2.5.5. */
		min-height: 2.75rem;
		min-width: 2.75rem;
		padding: 0 0.25rem;
		border: 0;
		background: none;
		font: inherit;
		color: inherit;
		cursor: pointer;
		opacity: 0.7;
	}

	.theme-toggle button:hover {
		opacity: 1;
	}

	.theme-toggle button[aria-pressed='true'] {
		opacity: 1;
		font-weight: 700;
		text-decoration: underline;
		color: var(--foreground);
	}

	.separator {
		opacity: 0.5;
	}
</style>
