---
import Layout from '../layouts/BlogPost.astro';
import { SITE_TITLE } from '../consts';
---

<Layout
	title="About"
	description={`About ${SITE_TITLE}.`}
	pubDate={new Date('August 16 2026')}
	heroImage="/blog-placeholder-about.jpg"
>
	<p>This is the about page for {SITE_TITLE}.</p>

	<p>
		Replace this text with your own introduction — you can edit it in
		<code>src/pages/about.astro</code>.
	</p>
</Layout>
